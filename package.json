{
    "name": "restful",
    "version": "1.0.0",
    "main": "dist/index.js",
    "author": "Jason K Seegmiller",
    "license": "MIT",
    "scripts": {
        "build": "rm -rf dist && babel src/ --out-dir dist/",
        "dev": "yarn mongo:start && nodemon --exec babel-node src/",
        "lint": "eslint src/",
        "mongo:start": "brew services start mongodb-community",
        "mongo:stop": "brew services stop mongodb-community",
        "start": "yarn mongo:start && node dist/index.js",
        "tests": "mocha --require @babel/register src/tests/"
    },
    "dependencies": {
        "body-parser": "^1.20.3",
        "express": "^4.21.2",
        "mongoose": "^6.13.9",
        "react": "^16.13.1",
        "react-dom": "^16.13.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.8.4",
        "@babel/core": "^7.9.0",
        "@babel/node": "^7.8.7",
        "@babel/preset-env": "^7.9.5",
        "@babel/preset-react": "^7.9.4",
        "@babel/register": "^7.9.0",
        "eslint": "^6.8.0",
        "eslint-config-airbnb": "^18.1.0",
        "eslint-plugin-import": "^2.20.2",
        "eslint-plugin-jsx-a11y": "^6.2.3",
        "eslint-plugin-react": "^7.19.0",
        "eslint-plugin-react-hooks": "^3.0.0",
        "mocha": "^7.1.1",
        "nodemon": "^2.0.3",
        "should": "^13.2.3",
        "sinon": "^9.0.2",
        "supertest": "^4.0.2",
        "yarn": "^1.22.4"
    },
    "resolutions": {
        "lodash": "^4.17.21",
        "minimatch": "^3.1.2",
        "ansi-regex": "^5.0.1",
        "debug": "^4.3.4",
        "braces": "^3.0.3",
        "glob-parent": "^5.1.2",
        "cross-spawn": "^7.0.3",
        "tmp": "^0.2.3",
        "ajv": "^6.12.6",
        "js-yaml": "^3.14.1",
        "flatted": "^3.3.1",
        "picomatch": "^2.3.1",
        "qs": "^6.11.0",
        "@babel/runtime": "^7.26.0",
        "@babel/runtime-corejs3": "^7.26.0",
        "path-to-regexp": "^0.1.10",
        "diff": "^5.0.0",
        "got": "^11.8.5"
    }
}
